{
  "name": "widthx/laravel-auth",
  "description": "Laravel integration for Widthx Identity: OIDC login/logout, back-channel logout and API token middleware.",
  "type": "library",
  "license": "MIT",
  "keywords": [
    "widthx",
    "oidc",
    "openid-connect",
    "oauth2",
    "laravel",
    "sso",
    "back-channel-logout"
  ],
  "homepage": "https://github.com/widthxhq/laravel-auth",
  "require": {
    "php": "^8.2",
    "widthx/auth": "^0.1",
    "illuminate/support": "^12.0|^13.0",
    "illuminate/http": "^12.0|^13.0",
    "illuminate/routing": "^12.0|^13.0",
    "illuminate/auth": "^12.0|^13.0",
    "illuminate/database": "^12.0|^13.0"
  },
  "require-dev": {
    "orchestra/testbench": "^10.0|^11.0",
    "phpunit/phpunit": "^11.5.3|^12.0"
  },
  "autoload": {
    "psr-4": {
      "Widthx\\Laravel\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Widthx\\Laravel\\Tests\\": "tests/"
    }
  },
  "extra": {
    "laravel": {
      "providers": [
        "Widthx\\Laravel\\WidthxServiceProvider"
      ]
    }
  },
  "prefer-stable": true
}
